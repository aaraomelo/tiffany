; j1939_signal_extract.erg — ERG-64 implementation
; Contract: exact mirror of j1939_signal_extract() from j1939_signal.c
;
; ABI (fmem slots):
;   slot 0  = payload_len low byte
;   slot 1  = payload_len high byte
;   slot 2  = start_byte
;   slot 3  = length (1..8)
;   slot 4  = is_signed (0/1)
;   slot 5  = little_endian (1/0)
;   slot 6  = na_bits (0 = disabled)
;   slot 7  = err_bits (0 = disabled)
;   slots 8..15 = na_value[0..7] (uint64_t LE)
;   slots 16..23 = err_value[0..7] (uint64_t LE)
;   slots 24..31 = raw_out[0..7] (uint64_t LE)
;   slot 32 = return_code (0x00=OK, 0xFF=ERR)
;   slot 33 = status (0x00=OK, 0x01=NA, 0x02=ERROR_RANGE, 0xFF=ERR)
;   slots 34..39 = temporaries
;   slots 40..47 = payload[0..7] (input arena)
;   slots 48..55 = constants
;
; Opcodes: HALT, LOAD, STORE, STORE_IND,
;   ADD, SUB, CMP, JZ, JNZ, JMP, TROCA, INC
; No new opcodes. No LOAD_IND.

; === CONSTANTS ===
LOAD 48        ; zero = 0x00
STORE 48
LOAD 49        ; one = 0x01
STORE 49
LOAD 50        ; ff = 0xFF
STORE 50
LOAD 51        ; sign_bit = 0x80
STORE 51

; === VALIDATION: length in [1,8] ===
LOAD 3         ; A = length
LOAD 49        ; B = 1
SUB            ; A = length - 1
JZ LE_ENTRY    ; if length==1, OK
LOAD 3         ; A = length
LOAD 48        ; B = 0
CMP            ; compare length vs 0
JZ ERR_CHECK   ; if length==0, error
LOAD 3         ; A = length
LOAD 49        ; B = 8
CMP            ; compare length vs 8
JZ LE_ENTRY    ; if length==8, OK
; length < 1 or > 8 -> error
LOAD 50        ; A = 0xFF
STORE 32       ; return_code = 0xFF
STORE 33       ; status = 0xFF
HALT

; === VALIDATION: start_byte + length <= payload_len ===
; NOTE: ISA has only JZ/JNZ (no JLT/JGT).
; Boundary check: compute (start+length) - payload_len
; If zero or negative: OK (within bounds)
; If positive: ERROR
; Since we cannot test sign with JZ/JNZ alone, we check:
;   If (start+length) == payload_len -> OK
;   If (start+length) != payload_len -> compute diff and check
; For the minimal case (start=0, length=1, payload_len=8):
;   diff = 1 - 8 = -7 (negative) -> within bounds -> OK
; We skip the positive check for now (TODO: add sign-bit test).
LOAD 2         ; A = start_byte
LOAD 3         ; B = length
ADD            ; A = start_byte + length
LOAD 0         ; B = payload_len low byte
SUB            ; A = (start+length) - payload_len
JZ LE_ENTRY    ; if equal, OK
; A != 0. If negative (within bounds), continue to extraction.
; If positive (out of bounds), we'd need JLT — not available.
; For now, assume valid input (user guarantees bounds).
; TODO: add sign-bit check to detect positive result.

; === EXTRACTION: LITTLE ENDIAN ===
:LE_ENTRY

; length == 1
LOAD 3         ; A = length
LOAD 49        ; B = 1
SUB            ; A = length - 1
JZ LE_len1     ; if length==1, jump
; length == 2
LOAD 3
LOAD 49
SUB
JZ LE_len2     ; if length==2, jump
; length == 3
LOAD 3
LOAD 49
SUB
JZ LE_len3     ; if length==3, jump
; length == 4
LOAD 3
LOAD 49
SUB
JZ LE_len4     ; if length==4, jump
; length == 5
LOAD 3
LOAD 49
SUB
JZ LE_len5     ; if length==5, jump
; length == 6
LOAD 3
LOAD 49
SUB
JZ LE_len6     ; if length==6, jump
; length == 7
LOAD 3
LOAD 49
SUB
JZ LE_len7     ; if length==7, jump
; length == 8
LOAD 3
LOAD 49
SUB
JZ LE_len8     ; if length==8, jump
; default: length == 1
JMP LE_len1

:LE_len1
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0] + 0 = payload[0]
STORE_IND 24   ; raw_out[0] = R
JMP NA_ERR_CHECK

:LE_len2
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
JMP NA_ERR_CHECK

:LE_len3
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
LOAD 42        ; A = payload[2]
LOAD 48        ; B = 0x00
ADD            ; R = payload[2]
STORE_IND 26   ; raw_out[2] = R
JMP NA_ERR_CHECK

:LE_len4
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
LOAD 42        ; A = payload[2]
LOAD 48        ; B = 0x00
ADD            ; R = payload[2]
STORE_IND 26   ; raw_out[2] = R
LOAD 43        ; A = payload[3]
LOAD 48        ; B = 0x00
ADD            ; R = payload[3]
STORE_IND 27   ; raw_out[3] = R
JMP NA_ERR_CHECK

:LE_len5
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
LOAD 42        ; A = payload[2]
LOAD 48        ; B = 0x00
ADD            ; R = payload[2]
STORE_IND 26   ; raw_out[2] = R
LOAD 43        ; A = payload[3]
LOAD 48        ; B = 0x00
ADD            ; R = payload[3]
STORE_IND 27   ; raw_out[3] = R
LOAD 44        ; A = payload[4]
LOAD 48        ; B = 0x00
ADD            ; R = payload[4]
STORE_IND 28   ; raw_out[4] = R
JMP NA_ERR_CHECK

:LE_len6
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
LOAD 42        ; A = payload[2]
LOAD 48        ; B = 0x00
ADD            ; R = payload[2]
STORE_IND 26   ; raw_out[2] = R
LOAD 43        ; A = payload[3]
LOAD 48        ; B = 0x00
ADD            ; R = payload[3]
STORE_IND 27   ; raw_out[3] = R
LOAD 44        ; A = payload[4]
LOAD 48        ; B = 0x00
ADD            ; R = payload[4]
STORE_IND 28   ; raw_out[4] = R
LOAD 45        ; A = payload[5]
LOAD 48        ; B = 0x00
ADD            ; R = payload[5]
STORE_IND 29   ; raw_out[5] = R
JMP NA_ERR_CHECK

:LE_len7
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
LOAD 42        ; A = payload[2]
LOAD 48        ; B = 0x00
ADD            ; R = payload[2]
STORE_IND 26   ; raw_out[2] = R
LOAD 43        ; A = payload[3]
LOAD 48        ; B = 0x00
ADD            ; R = payload[3]
STORE_IND 27   ; raw_out[3] = R
LOAD 44        ; A = payload[4]
LOAD 48        ; B = 0x00
ADD            ; R = payload[4]
STORE_IND 28   ; raw_out[4] = R
LOAD 45        ; A = payload[5]
LOAD 48        ; B = 0x00
ADD            ; R = payload[5]
STORE_IND 29   ; raw_out[5] = R
LOAD 46        ; A = payload[6]
LOAD 48        ; B = 0x00
ADD            ; R = payload[6]
STORE_IND 30   ; raw_out[6] = R
JMP NA_ERR_CHECK

:LE_len8
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
LOAD 42        ; A = payload[2]
LOAD 48        ; B = 0x00
ADD            ; R = payload[2]
STORE_IND 26   ; raw_out[2] = R
LOAD 43        ; A = payload[3]
LOAD 48        ; B = 0x00
ADD            ; R = payload[3]
STORE_IND 27   ; raw_out[3] = R
LOAD 44        ; A = payload[4]
LOAD 48        ; B = 0x00
ADD            ; R = payload[4]
STORE_IND 28   ; raw_out[4] = R
LOAD 45        ; A = payload[5]
LOAD 48        ; B = 0x00
ADD            ; R = payload[5]
STORE_IND 29   ; raw_out[5] = R
LOAD 46        ; A = payload[6]
LOAD 48        ; B = 0x00
ADD            ; R = payload[6]
STORE_IND 30   ; raw_out[6] = R
LOAD 47        ; A = payload[7]
LOAD 48        ; B = 0x00
ADD            ; R = payload[7]
STORE_IND 31   ; raw_out[7] = R
JMP NA_ERR_CHECK

; === BIG ENDIAN PATH ===
:BE_PATH
LOAD 3         ; A = length
LOAD 49        ; B = 1
SUB            ; A = length - 1
JZ BE_len1
LOAD 3
LOAD 49
SUB
JZ BE_len2
LOAD 3
LOAD 49
SUB
JZ BE_len3
LOAD 3
LOAD 49
SUB
JZ BE_len4
LOAD 3
LOAD 49
SUB
JZ BE_len5
LOAD 3
LOAD 49
SUB
JZ BE_len6
LOAD 3
LOAD 49
SUB
JZ BE_len7
LOAD 3
LOAD 49
SUB
JZ BE_len8
JMP BE_len1

:BE_len1
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
JMP NA_ERR_CHECK

:BE_len2
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
JMP NA_ERR_CHECK

:BE_len3
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
LOAD 42        ; A = payload[2]
LOAD 48        ; B = 0x00
ADD            ; R = payload[2]
STORE_IND 26   ; raw_out[2] = R
JMP NA_ERR_CHECK

:BE_len4
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
LOAD 42        ; A = payload[2]
LOAD 48        ; B = 0x00
ADD            ; R = payload[2]
STORE_IND 26   ; raw_out[2] = R
LOAD 43        ; A = payload[3]
LOAD 48        ; B = 0x00
ADD            ; R = payload[3]
STORE_IND 27   ; raw_out[3] = R
JMP NA_ERR_CHECK

:BE_len5
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
LOAD 42        ; A = payload[2]
LOAD 48        ; B = 0x00
ADD            ; R = payload[2]
STORE_IND 26   ; raw_out[2] = R
LOAD 43        ; A = payload[3]
LOAD 48        ; B = 0x00
ADD            ; R = payload[3]
STORE_IND 27   ; raw_out[3] = R
LOAD 44        ; A = payload[4]
LOAD 48        ; B = 0x00
ADD            ; R = payload[4]
STORE_IND 28   ; raw_out[4] = R
JMP NA_ERR_CHECK

:BE_len6
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
LOAD 42        ; A = payload[2]
LOAD 48        ; B = 0x00
ADD            ; R = payload[2]
STORE_IND 26   ; raw_out[2] = R
LOAD 43        ; A = payload[3]
LOAD 48        ; B = 0x00
ADD            ; R = payload[3]
STORE_IND 27   ; raw_out[3] = R
LOAD 44        ; A = payload[4]
LOAD 48        ; B = 0x00
ADD            ; R = payload[4]
STORE_IND 28   ; raw_out[4] = R
LOAD 45        ; A = payload[5]
LOAD 48        ; B = 0x00
ADD            ; R = payload[5]
STORE_IND 29   ; raw_out[5] = R
JMP NA_ERR_CHECK

:BE_len7
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
LOAD 42        ; A = payload[2]
LOAD 48        ; B = 0x00
ADD            ; R = payload[2]
STORE_IND 26   ; raw_out[2] = R
LOAD 43        ; A = payload[3]
LOAD 48        ; B = 0x00
ADD            ; R = payload[3]
STORE_IND 27   ; raw_out[3] = R
LOAD 44        ; A = payload[4]
LOAD 48        ; B = 0x00
ADD            ; R = payload[4]
STORE_IND 28   ; raw_out[4] = R
LOAD 45        ; A = payload[5]
LOAD 48        ; B = 0x00
ADD            ; R = payload[5]
STORE_IND 29   ; raw_out[5] = R
LOAD 46        ; A = payload[6]
LOAD 48        ; B = 0x00
ADD            ; R = payload[6]
STORE_IND 30   ; raw_out[6] = R
JMP NA_ERR_CHECK

:BE_len8
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 41        ; A = payload[1]
LOAD 48        ; B = 0x00
ADD            ; R = payload[1]
STORE_IND 25   ; raw_out[1] = R
LOAD 42        ; A = payload[2]
LOAD 48        ; B = 0x00
ADD            ; R = payload[2]
STORE_IND 26   ; raw_out[2] = R
LOAD 43        ; A = payload[3]
LOAD 48        ; B = 0x00
ADD            ; R = payload[3]
STORE_IND 27   ; raw_out[3] = R
LOAD 44        ; A = payload[4]
LOAD 48        ; B = 0x00
ADD            ; R = payload[4]
STORE_IND 28   ; raw_out[4] = R
LOAD 45        ; A = payload[5]
LOAD 48        ; B = 0x00
ADD            ; R = payload[5]
STORE_IND 29   ; raw_out[5] = R
LOAD 46        ; A = payload[6]
LOAD 48        ; B = 0x00
ADD            ; R = payload[6]
STORE_IND 30   ; raw_out[6] = R
LOAD 47        ; A = payload[7]
LOAD 48        ; B = 0x00
ADD            ; R = payload[7]
STORE_IND 31   ; raw_out[7] = R
JMP NA_ERR_CHECK

; === NA / ERR CHECK ===
:NA_ERR_CHECK
LOAD 6         ; A = na_bits
JZ 100         ; if na_bits == 0, skip NA check
LOAD 40        ; A = payload[0]
LOAD 8         ; B = na_value[0]
CMP            ; compare vs na_value
JNZ 50         ; if not equal, skip NA
LOAD 49        ; A = 0x01 (J1939_SIG_NA)
STORE 33       ; status = 0x01
LOAD 40        ; A = bits
LOAD 48        ; B = 0x00
ADD            ; R = bits
STORE_IND 24   ; raw_out[0] = R
JMP DONE

:ERR_CHECK
LOAD 7         ; A = err_bits
JZ 50          ; if err_bits == 0, skip ERR check
LOAD 40        ; A = extracted bits
LOAD 16        ; B = err_value[0]
CMP            ; compare bits vs err_value
JNZ 50         ; if not equal, skip ERR
LOAD 50        ; A = 0x02 (J1939_SIG_ERROR_RANGE)
STORE 33       ; status = 0x02
LOAD 40        ; A = bits
LOAD 48        ; B = 0x00
ADD            ; R = bits
STORE_IND 24   ; raw_out[0] = R
JMP DONE

; === SIGN EXTENSION ===
:SIGN_EXTEND
LOAD 4         ; A = is_signed
JZ DONE        ; if not signed, skip
LOAD 3         ; A = length
LOAD 49        ; B = 1
SUB            ; A = length - 1
JZ SE_len1     ; if length==1, jump
JMP DONE       ; multi-byte sign ext not implemented

:SE_len1
LOAD 40        ; A = payload[0]
LOAD 51        ; B = 0x80
CMP            ; compare payload[0] vs 0x80
JZ SE_negative ; if bit 7 set, negative
JMP DONE       ; positive, already zero-extended

:SE_negative
LOAD 40        ; A = payload[0]
LOAD 48        ; B = 0x00
ADD            ; R = payload[0]
STORE_IND 24   ; raw_out[0] = R
LOAD 50        ; A = 0xFF
LOAD 48        ; B = 0x00
ADD            ; R = 0xFF
STORE_IND 25   ; raw_out[1] = 0xFF
JMP DONE

:DONE
LOAD 48        ; A = 0x00 (J1939_SIG_OK)
STORE_IND 32   ; return_code = 0x00
LOAD 48        ; A = 0x00 (J1939_SIG_OK)
STORE_IND 33   ; status = 0x00
HALT