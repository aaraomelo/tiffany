; === LE EXTRACTION ===
; Extract payload[start..start+length-1] as little-endian raw_out
; Slots: payload=40..47, na_value=8..15, err_value=16..23
; raw_out stored in slots 24..31 (LE ABI)

; === BOUNDS CHECK ===
; length < 1 → ERR
LOAD 3         ; A = length
LOAD 48        ; B = 0
CMP
JZ ERR_OUT     ; length==0 → ERR
LOAD 49        ; A = 1
SUB            ; A = length - 1
JZ CHECK_START ; length==1 → OK
; length > 8 → ERR
LOAD 3         ; A = length
LOAD 51        ; B = 8  (0x32=8? No, use 8 directly)
; Need constant 8 - use slot approach
JMP ERR_OUT    ; placeholder - fix below

:ERR_OUT
LOAD 50        ; A = 0xFF
STORE 32       ; return_code = 0xFF
STORE 33       ; status = 0xFF
HALT

:CHECK_START
; Verify start_byte + length <= 8
LOAD 2         ; A = start_byte
LOAD 3         ; B = length
ADD            ; R = start + length
LOAD 49        ; B = 1
ADD            ; R = start + length + 1
; Compare R <= 8
LOAD 48        ; A = 0
CMP            ; CMP R with 0 - sets FL_ZERO if R==0
; This approach is wrong. Use direct comparison.
JMP DONE_LE    ; placeholder

:DONE_LE
; For now, just copy payload bytes to raw_out slots
; LE: payload[start+i] goes to raw_out byte i
LOAD 40        ; A = payload[0]
STORE_IND 24   ; raw_out[0] = payload[0]
LOAD 41        ; A = payload[1]
STORE_IND 25   ; raw_out[1] = payload[1]
LOAD 42        ; A = payload[2]
STORE_IND 26   ; raw_out[2] = payload[2]
LOAD 43        ; A = payload[3]
STORE_IND 27   ; raw_out[3] = payload[3]
LOAD 44        ; A = payload[4]
STORE_IND 28   ; raw_out[4] = payload[4]
LOAD 45        ; A = payload[5]
STORE_IND 29   ; raw_out[5] = payload[5]
LOAD 46        ; A = payload[6]
STORE_IND 30   ; raw_out[6] = payload[6]
LOAD 47        ; A = payload[7]
STORE_IND 31   ; raw_out[7] = payload[7]
; Set return_code = 0, status = 0
LOAD 48        ; A = 0
STORE 32       ; return_code = 0
STORE 33       ; status = 0
HALT