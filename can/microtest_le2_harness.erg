; Microtest: LE len=2 via bridge_test3 harness
; payload[0]=0x34, payload[1]=0x12
; Expected LE raw logical = 0x1234
; raw_out LE storage: slots 24..31 = 34 12 00 00 00 00 00 00
; status=0 (OK), return=0 (OK)
LOAD 40        ; A = payload[0] = 0x34
LOAD 48        ; B = 0x00
ADD            ; R = 0x34
STORE_IND 24   ; raw_out[0] = 0x34
LOAD 41        ; A = payload[1] = 0x12
LOAD 48        ; B = 0x00
ADD            ; R = 0x12
STORE_IND 25   ; raw_out[1] = 0x12
LOAD 48        ; A = 0x00
STORE 32       ; return_code = OK
STORE 33       ; status = OK
HALT