% papers/partitura.tex
% Partitura do Tradutor --- DESENHADA pelo tradutor (tex.wasm).
% Produto = partitura no pentagrama (eval). Tabela = só auditoria.
% Geometria: pentagrama = pera/cone; música = espiral da vareta (Maestro).
% Vozes: \input{partitura_vozes} gerado por partitura/emite.c tex
%
%   cd partitura && cc -O2 -std=c99 -Wall emite.c -o emite
%   ./emite tex -o ../papers/partitura_vozes.tex
%   tests/tex papers/partitura.tex saida.pdf
\documentclass[11pt,a4paper]{article}
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[portuguese]{babel}
\usepackage{amsmath,amssymb,amsthm}
\usepackage[margin=2.5cm]{geometry}
\usepackage{booktabs}
\usepackage{xcolor}
\usepackage[hidelinks]{hyperref}
\newtheorem{definicao}{Definição}
\newtheorem{observacao}{Observação}
\newcommand{\code}[1]{\texttt{#1}}

% Alfabeto ritmico --- Lei~1 (nu) + espiral de expoentes (translacao Y)
\newcommand{\N}{\note}
\newcommand{\Rr}{\ensuremath{\cdot}\,}
\newcommand{\Bb}{|\,}
% Lei~6: tick = bulbo na régua (eval: \bullet na linha; sem haste a enganar o olho)
\newcommand{\Tick}{$\bullet$}

% Cone / pera --- cinco geratrizes (Lei~5). Régua = largura COL (thm:morfologico).
\newcommand{\Penta}{%
\noindent\reguacol{0.32pt}\\[-1.55mm]%
\noindent\reguacol{0.32pt}\\[-1.55mm]%
\noindent\reguacol{0.32pt}\\[-1.55mm]%
\noindent\reguacol{0.32pt}\\[-1.55mm]%
\noindent\reguacol{0.32pt}%
}
\newcommand{\PentaUm}{\noindent\reguacol{0.32pt}}

% π_página + morfologia horizontal: dilata a voz a [0,W] (Lei~4 / thm:morfologico).
\newcommand{\VozAbre}[4]{%
\pipagina{36mm}%
\par\medskip\noindent
\textbf{#1}\quad{\small\color{regua}#2}\par\vspace{3mm}%
#3\par
\vspace{#4}%
\morfh\noindent
}

% Metrónomo: régua COL + ticks dilatados em W (λ⁺+λ⁻=0 no eixo).
\newcommand{\VozMetro}[2]{%
\pipagina{22mm}%
\par\medskip\noindent
\textbf{Metronomo}\quad{\small\color{regua}#1}\par\vspace{3mm}%
\PentaUm\vspace{#2}%
\morfh\noindent
}

\input{gkcapa}
\begin{document}
\gkcapa{Partitura do Tradutor}
       {$\Pi_{\mathrm{tradutor}}\longmapsto\Pi_{\mathrm{musical}}$}
       {pentagrama $=$ pera/cone; música $=$ espiral da vareta}
\maketitle

\begin{abstract}
\noindent Produto: a \textbf{partitura desenhada}. O pentagrama é o
\textbf{cone} (pera); a música é a \textbf{espiral} que sai da dinâmica
da vareta do Maestro e projecta a orquestra. Eixos: horizontal $=$
Metrónomo (tick, $\lambda^{+}+\lambda^{-}=0$); vertical $=$ altura no cone
--- não a diagonal. LilyPond grava; o tradutor desenha.
\end{abstract}

\section{Geometria (não a diagonal)}

\[
\boxed{
\mathrm{Conservat\acute{o}rio}
\;\xrightarrow{\mathrm{Pera}}\;
\text{vareta}
\;\rightarrow\;
P(t)
\;\rightarrow\;
\text{espiral}
\;\rightarrow\;
\text{orquestra}.
}
\]
\[
\boxed{
\text{pentagrama}=\text{pera}/\text{cone};
\quad
\text{música}=\text{espiral da vareta}.
}
\]
\begin{itemize}
\item \textbf{Horizontal} --- Teorema do Metrónomo: tick / leitura
métrica; involução $\lambda^{+}\leftrightarrow\lambda^{-}$.
\item \textbf{Vertical} --- cone (pera): altura no pentagrama; involução
$\nu$ (clave sol$\leftrightarrow$fá, figura$\leftrightarrow$silêncio).
\item \textbf{Maestro} --- Teorema $\mathcal{P}_k=\mathrm{tick}\circ\mathrm{batuta}\circ\Pi$:
projecta $\pi_k$; a vareta escreve a espiral; a orquestra realiza.
\end{itemize}

\section{Cadeia}

\[
\boxed{
\text{corpo}
\to\pi_k\to\Pi\to\text{Maestro}\to\text{vozes}\to\text{partitura}.
}
\]

\section{Condições (Peano / estelar)}

\begin{definicao}[Pentagrama $=$ pera / cone]
Cinco \verb|\rule| --- realização do \textbf{cone} (Def.~pera no Corpo de
Peano): base da batuta onde o conservatório entra no canal. Não é tabela
nem diagonal: é o suporte cónico da escrita.
\end{definicao}

\begin{definicao}[Música $=$ espiral]
A trajectória $P(t)$ na ponta da vareta --- periódica / espiralada ---
projecta os naipes. No tradutor a altura no cone realiza-se pela
\textbf{espiral de expoentes} ($_{\note}$, $\note$, $^{\note}$, \ldots)
--- a mesma subida $\mathrm{esp\_gira}$ do núcleo. $\Pi$ não inventa a
órbita: sai da dinâmica do Maestro sob o tick comum.
\end{definicao}

\begin{definicao}[Involução $\nu$ --- Lei~1 (eixo vertical)]
\[
\mathrm{figura}\;\overset{\nu}{\longleftrightarrow}\;\mathrm{silêncio},
\qquad\nu\circ\nu=\mathrm{id}
\]
(\verb|\N| $\leftrightarrow$ \verb|\Rr|). Clave sol
$\overset{\nu}{\longleftrightarrow}$ fá.
\end{definicao}

\begin{definicao}[Metrónomo --- Lei~6 (eixo horizontal)]
Tick comum; $\lambda^{+}+\lambda^{-}=0$ na volta fechada. Lê; não inventa
$\Delta$.
\end{definicao}

\begin{definicao}[Trial --- Lei~3]
Batuta canaliza $I\in\{-1,0,+1\}$ na vareta: grave / neutro / agudo.
\end{definicao}

\begin{definicao}[Maestro --- $\pi_k$]
Projecção sustentada no cone; ataque + silêncios ($\nu$) $=$ semibreve
no gabarito.
\end{definicao}

\begin{definicao}[Naipes / Lei~8]
Hurwitz $1,2,4,8$ e $\mathbb{Z}/8\mathbb{Z}$ --- a orquestra sob a
espiral.
\end{definicao}

\begin{definicao}[Página --- dimensão do relógio ($\pi_{\mathrm{página}}$)]
A página não interrompe o sistema: é um \textbf{andar de composição}
sob o mesmo Maestro.
\[
\boxed{
\mathrm{tick}
\rightarrow
\mathrm{compasso}
\rightarrow
\mathrm{partitura}
\rightarrow
\mathrm{página}
\rightarrow
\mathrm{torre}
}
\]
$\pi_{\mathrm{página}}$ projecta o bloco contínuo no suporte $P_n$; se
não cabe, $P_n\xrightarrow{\pi}P_{n+1}$ --- muda o suporte, não o
estado (relógio, espiral, voz, métrica, $\Pi$, linha dourada).
Partituras e tabelas quebram assim, sem pulo externo.
\end{definicao}

\begin{definicao}[Morfologia --- Lei~4 no suporte ($W$ primeiro)]
Dual espacial do par Maestro\,/\,Metrónomo
(Teorema~\ref{thm:morfologico} em \code{corpo\_peano}):
\[
\boxed{(\mathrm{dilata},\mathrm{contrai})\;\longleftrightarrow\;(\mathrm{Maestro},\mathrm{Metr\acute{o}nomo}).}
\]
$\mathcal{M}(\Pi)\sim\Pi$: ocupa $[0,W]$ (largura) antes da altura;
a pauta e as notas partilham a régua COL --- sem acumular à esquerda.
\end{definicao}

% Maestro: se o início da partitura não cabe, projecta P_{n+1} (sem \clearpage).
\pipagina{50mm}%
\section{A partitura do sistema}

\input{partitura_vozes}

\begin{observacao}
Fonte: \code{./emite tex}. Gabarito: \code{partitura/render/tradutor-completo.pdf}.
Coluna comum $=$ barras no mesmo tick (Metrónomo). Altura no cone $=$
espiral de expoentes ($_{\note}\ldots^{\note}$) no tradutor; cromática no
LilyPond.
\end{observacao}

% Fecho+auditoria = um bloco: P_n→P_{n+1} sem órfão de frase.
\pipagina{55mm}%
\section{Auditoria (não o produto)}

\begin{center}\small
\begin{tabular}{@{}lccc@{}}
voz & eixo / papel & involução & conteúdo \\
\midrule
Met. & horizontal / Lei~6 & $\lambda^{\pm}$ & tick \\
Bat. & vareta / Lei~3 & trial $I$ & canal \\
Mae. & projecção $\pi_k$ & --- & espiral-fonte \\
orquestra & cone + espiral & $\nu$ & naipes / Lei~8 \\
\end{tabular}
\end{center}

\pipagina{16mm}%
\section{Fecho}

\begin{observacao}
\textbf{A partitura desenhada.}
Cone (pera) + espiral da vareta --- Maestro e Metrónomo, não a diagonal.
\end{observacao}

\end{document}

