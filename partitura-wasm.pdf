% papers/partitura.tex
% Partitura --- DESENHADA pelo tradutor (tex.wasm).
% Produto = Π^{Peano} = Assinatura(corpo_peano) no pentagrama.
%
%   cd partitura && cc -O2 -std=c99 -Wall emite.c -o emite
%   ./emite -o ../papers/partitura_vozes.tex
%   tests/tex papers/partitura.tex partitura-wasm.pdf
%   bash tools/sobe_tex_wasm.sh
\documentclass[11pt,a4paper]{article}
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[portuguese]{babel}
\usepackage{amsmath,amssymb,amsthm}
\usepackage[margin=2.5cm]{geometry}
\usepackage{booktabs}
\usepackage{xcolor}
\usepackage[hidelinks]{hyperref}
\newtheorem{definicao}{Definição}
\newtheorem{observacao}{Observação}
\newcommand{\code}[1]{\texttt{#1}}

% --- Alfabeto rítmico --- Lei~1 (nu) + espiral de expoentes (translação Y)
\newcommand{\N}{\note}
\newcommand{\Rr}{\ensuremath{\cdot}\,}
\newcommand{\Bb}{|\,}
\newcommand{\Tick}{$\bullet$}

% --- Cabeça clássica: claves NATIVAS no tradutor (Emmentaler→polígono) ---
% \ClaveG / \ClaveF / \ClaveP — não redefinir (senão vira letra G/F).
\newcommand{\Armadura}[1]{\ensuremath{#1}\,}
\newcommand{\Compas}[2]{\ensuremath{\tfrac{#1}{#2}}\,}
\newcommand{\CabecaG}[2]{\ClaveG\Armadura{}\Compas{#1}{#2}}
\newcommand{\CabecaF}[2]{\ClaveF\Armadura{}\Compas{#1}{#2}}
\newcommand{\CabecaP}[2]{\ClaveP\Compas{#1}{#2}}
\newcommand{\BbDupla}{\ensuremath{\|}\,}
\newcommand{\BbFinal}{\ensuremath{\|\!|}\,}% barra final (sem \kern/\rule --- vazavam ``0.35pt'')
\newcommand{\Din}[1]{\textit{#1}\,}
\newcommand{\Acento}{$>$\,}
\newcommand{\Ligadura}{\ensuremath{\smallfrown}\,}
\newcommand{\NotaSemibreve}{$\circ$}
\newcommand{\NotaMinima}{$\note$}
\newcommand{\NotaSeminima}{\note}

\newcommand{\Penta}{%
\noindent\reguacol{0.32pt}\\[-1.55mm]%
\noindent\reguacol{0.32pt}\\[-1.55mm]%
\noindent\reguacol{0.32pt}\\[-1.55mm]%
\noindent\reguacol{0.32pt}\\[-1.55mm]%
\noindent\reguacol{0.32pt}%
}
\newcommand{\PentaUm}{\noindent\reguacol{0.32pt}}

% Página = andar do relógio do Maestro (Def.~π_página). \AndarPagina = P_n→P_{n+1}.
\newcommand{\AndarPagina}{\newpage}%
% Reserva o bloco do andar: se não cabe no resto de P_n, salta para P_{n+1}.
\newcommand{\AndarAbre}{\pipagina{170mm}}%
\newcommand{\PartituraSecao}{\section{A partitura (obra)}}%

% Uma voz no andar corrente: pauta + música. π_página reserva o bloco.
\newcommand{\VozAbre}[4]{%
\morfvstep
\pipagina{28mm}%
\par\medskip\noindent
\textbf{#1}\quad{\small\color{regua}#2}\par\vspace{2mm}%
#3\par
\vspace{#4}%
\morfh\noindent
}

\newcommand{\VozMetro}[2]{%
\morfvstep
\pipagina{16mm}%
\par\medskip\noindent
\textbf{Metronomo}\quad{\small\color{regua}#1}\par\vspace{2mm}%
\PentaUm\vspace{#2}%
\morfh\noindent
}

\input{gkcapa}
\begin{document}
\gkcapa{Partitura do Corpo de Peano}
       {$\operatorname{Assinatura}(\texttt{corpo\_peano})\longmapsto\Pi^{\mathrm{Peano}}$}
       {desenhada pelo tradutor WASM --- não sonificação}
\maketitle

\begin{abstract}
\noindent Produto: a \textbf{partitura desenhada} de
\code{papers/corpo\_peano.tex}. Cadeia
\[
\boxed{
\operatorname{Assinatura}(\mathcal{C}_{\mathrm{Peano}})
\xrightarrow{\Pi}
\mathrm{Maestro}\circ\mathcal{M}(\Pi)
=
\text{esta folha}.
}
\]
Cada elemento clássico tem origem no Corpo de Peano. A morfologia
$(W,H)$ dilata o suporte e preserva $\Pi$, ticks, vozes e métrica.
\end{abstract}

\section{Assinatura $\Pi^{\mathrm{Peano}}$}

\[
\boxed{
d{=}8,\;
S{=}\mathrm{SementeEstrela},\;
G{=}\mathrm{Hurwitz}\cup\mathbb{Z}/8\mathbb{Z},\;
\tfrac{n}{m}{=}4/4,\;
\mathrm{Iface}{=}6,\;
\mathrm{Lado}{=}0.
}
\]
\[
\boxed{
\text{corpo}
\to\Pi\to\pi_k\to\text{Maestro}\to\text{vozes}\to\text{partitura};
\quad
\text{assinatura}
\to\text{tempo}\to Y\to(W,H)\to\text{página}.
}
\]

\begin{definicao}[Cabeça clássica]
pauta $\to$ \verb|\Cabeca*| $(\kappa,\alpha,n/m)$ $\to$ $F/R$ $\to$
\verb|\Bb| $\to$ \verb|\BbFinal|.
\end{definicao}

\begin{definicao}[Morfologia --- $(W,H)$]
$W\leftarrow$Lei~4; $H\leftarrow\operatorname{Ind}^{8}$/Estrela
(requer \verb|\estrela|). $\mathcal{M}(\Pi)\sim\Pi$.
\end{definicao}

\pipagina{50mm}%
% Secção abre com o andar (via \PartituraSecao no emite) para não deixar página vazia.
\estrela
\input{partitura_vozes}

\begin{observacao}
Fonte: \code{partitura/emite.c} $\to$ \code{partitura\_vozes.tex}.
Página $=$ andar do relógio do Maestro (meia volta $=$ Dim$/2$ compassos);
vozes em paralelo por andar; \verb|\AndarPagina| avança $P_n\to P_{n+1}$.
Produto: \code{partitura-wasm.pdf}.
\end{observacao}

\pipagina{40mm}%
\section{Auditoria (não o produto)}

\begin{center}\small
\begin{tabular}{@{}lccc@{}}
voz & eixo / papel & involução & conteúdo \\
\hline
Metrónomo & horizontal / tick & $\lambda^{\pm}$ & \verb|\Tick| \\
Batuta & trial $I$ & --- & \verb|\Acento| / ataque \\
Maestro & $\pi_k$ & --- & projecção \\
naipes & Hurwitz $1,2,4,8$ & --- & $G_i$ \\
Lei~8 & $\mathbb{Z}/8\mathbb{Z}$ & $\operatorname{Ind}^{8}$ & ciclo \\
\end{tabular}
\end{center}

\end{document}

endstream
