# Modelo do .env — COPIAR para .env e preencher. O .env real nunca entra no git.
SSH_HOST=
SSH_USER=
SSH_KEY=segredo/a-tua-chave
SSH_OPTS="-i segredo/a-tua-chave -o StrictHostKeyChecking=accept-new -o ConnectTimeout=30"
DEPLOY_DIR=/var/www/goldenkingdom
SITE_URL=https://goldenkingdom.patriatechnology.com
