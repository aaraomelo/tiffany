generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  pending
  planning
  needs_info
  awaiting_approval
  approved
  replanning
  executing
  deploying
  completed
  failed
  rejected
  cancelled
  timed_out
}

enum ExecutionPhase {
  planning
  replanning
  execution
}

enum Environment {
  dev
  homolog
  prod
}

enum ProjectStatus {
  planning
  awaiting_review
  approved
  executing
  paused
  completed
  failed
  cancelled
}

// --- Projects ---

model Project {
  id            String        @id @default(uuid())
  name          String
  description   String?
  status        ProjectStatus @default(planning)
  autoApprove   Boolean       @default(false) @map("auto_approve")
  createdBy     String        @default("patricia") @map("created_by")
  channel       String        @default("whatsapp")
  target        String        @default("+5511977808883")
  totalSubtasks Int           @default(0) @map("total_subtasks")
  doneSubtasks  Int           @default(0) @map("done_subtasks")
  environment   Environment   @default(dev)
  promoteTo     Environment?  @map("promote_to")
  branch        String?
  branchDeleted Boolean       @default(false) @map("branch_deleted")
  deployedDevAt    DateTime?  @map("deployed_dev_at")
  deployedHomologAt DateTime? @map("deployed_homolog_at")
  deployedProdAt   DateTime?  @map("deployed_prod_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  subtasks  Task[]
  plannings ProjectPlanning[]

  @@index([status])
  @@map("projects")
}

model ProjectPlanning {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  role      String   // "claude" | "director"
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("project_plannings")
}

// --- Tasks ---

model Task {
  id            String     @id @default(uuid())
  status        TaskStatus @default(pending)
  command       String
  description   String?
  repo          String?    @map("project")
  createdBy     String     @default("patricia") @map("created_by")
  channel       String     @default("whatsapp")
  target        String     @default("+5511977808883")
  templateId    String?    @map("template_id")
  replanCount   Int        @default(0) @map("replan_count")
  projectId     String?    @map("project_id")
  sortOrder     Int        @default(0) @map("sort_order")
  dependsOnId   String?    @map("depends_on_id")
  environment   Environment @default(dev)
  promoteTo     Environment? @map("promote_to")
  branch        String?
  branchDeleted Boolean    @default(false) @map("branch_deleted")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  template      TaskTemplate? @relation(fields: [templateId], references: [id])
  parentProject Project?      @relation(fields: [projectId], references: [id])
  dependsOn     Task?         @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependedBy    Task[]        @relation("TaskDependency")
  executions    TaskExecution[]
  transitions   TaskTransition[]

  @@index([status])
  @@index([status, updatedAt])
  @@index([projectId, sortOrder])
  @@map("tasks")
}

model TaskExecution {
  id         String         @id @default(uuid())
  taskId     String         @map("task_id")
  phase      ExecutionPhase
  plan       String?
  question   String?
  feedback   String?
  result     String?
  commitSha  String?        @map("commit_sha")
  startedAt  DateTime       @default(now()) @map("started_at")
  finishedAt DateTime?      @map("finished_at")

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@map("task_executions")
}

model TaskTransition {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  fromStatus String   @map("from_status")
  toStatus   String   @map("to_status")
  actor      String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@map("task_transitions")
}

// --- Auth ---

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  revokedAt DateTime @default(now()) @map("revoked_at")

  @@index([token])
  @@map("revoked_tokens")
}

// --- Contacts ---

model Contact {
  id               String   @id @default(uuid())
  name             String
  email            String
  message          String
  phone            String?
  whatsappConsent  Boolean  @default(false) @map("whatsapp_consent")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("contacts")
}

model TaskTemplate {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  commandTemplate     String   @map("command_template")
  descriptionTemplate String?  @map("description_template")
  repo                String?  @map("project")
  fields              Json     @default("[]")
  createdBy           String   @map("created_by")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tasks Task[]

  @@index([slug])
  @@map("task_templates")
}
