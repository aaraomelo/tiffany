%% tiffany-partitura.sty --- pacote de partituras do Reino Dourado
%%
%% Objectivo: Pi_tradutor |-> Pi_musical (todas as vozes, um relogio).
%% Musica = linguagem OPERACIONAL da projeccao (pi_k), nao sonificacao.
%% LilyPond/lyluatex gravam; nao fundam. emite.c e o emissor nativo.
%%
%% Cadeia: relogio -> metronomo -> maestro -> batuta -> Pi -> pi_k -> orquestra
%% Teoria: papers/corpo_peano.tex; paper: partitura/partitura.tex
%%
%% Compilacao: lualatex -shell-escape partitura.tex   (requer lilypond)
%% Sem lilypond: opcao [noly] --- texto + .ly em listings.
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tiffany-partitura}[2026/08/12 v0.4 render tipografico nos papers]

\RequirePackage{ifthen}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{amsmath,amssymb}
\RequirePackage{xcolor}
\RequirePackage{listings}
\lstset{basicstyle=\ttfamily\footnotesize,frame=single,breaklines=true,
        columns=fullflexible,keepspaces=true}

\newif\iftiffany@ly
\tiffany@lyfalse
\DeclareOption{noly}{\tiffany@lyfalse}
\DeclareOption{ly}{\tiffany@lytrue}
\ProcessOptions\relax

%% Carrega lyluatex só se pedido e se o sty existir (LuaLaTeX).
\iftiffany@ly
  \IfFileExists{lyluatex.sty}{%
    \RequirePackage[
      staffsize=16,
      pass-fonts=true
    ]{lyluatex}%
  }{%
    \PackageWarning{tiffany-partitura}{lyluatex.sty ausente --- modo texto}%
    \tiffany@lyfalse
  }
\fi

%% ─── Dicionário operacional (corpo_peano Def. partitura / naipes) ───────────
%%
%%  Π = Π_assinatura + Π_notação
%%  Π_assinatura = (d, S, G, ℓ, C, Δ)
%%  Π_notação    = (P, κ, α, n/m, F, R, B, ω)
%%
%%  Gravação Tiffany → LilyPond (realização tipográfica, NÃO dados→notas):
%%    d        →  StaffGroup / oitava (andar)
%%    S        →  \key (semente tonal)
%%    G / naipe→  instrumentName + clef (Hurwitz 1/2/4/8 --- classes, não eixos)
%%    ℓ        →  \time  (períodos {2,3,4,8} e interfaces {6,12,24})
%%    C        →  \clef
%%    Δ        →  acidente / microtom (bordo metálico)
%%    (p,q,r)  →  trial: + projecta, − reflecte, 0 silêncio (Lei 1)
%%    F ↔ R    →  nota ↔ pausa (ν)
%%    Maestro  →  dinâmica / articulação (λ⁺)
%%    Metrónomo→  \tempo / pulso (λ⁻)
%%    Lei 8    →  motivo Z/8Z (k |-> k+1 mod 8)

\newcommand{\TiffanyPiAssinatura}[6]{%
  \ensuremath{(d{=}#1,\,S{=}#2,\,G{=}#3,\,\ell{=}#4,\,C{=}#5,\,\Delta{=}#6})}
\newcommand{\TiffanyPiNotacao}{%
  \ensuremath{(P,\kappa,\alpha,\tfrac{n}{m},F,R,B,\omega})}

%% Compás do modelo → \time LilyPond
\newcommand{\TiffanyCompasLy}[2]{%
  \texttt{\string\time\ #1/#2}}

%% Naipe Hurwitz → instrumento + clave (convenção do modelo)
\newcommand{\TiffanyNaipeLy}[1]{%
  \ifthenelse{\equal{#1}{Cordas}}{Violin, clef treble}{%
  \ifthenelse{\equal{#1}{Madeiras}}{Flute, clef treble}{%
  \ifthenelse{\equal{#1}{Metais}}{Horn, clef treble}{%
  \ifthenelse{\equal{#1}{Percussao}}{Timpani, clef bass}{%
  Voice, clef treble}}}}}

%% Caixa de metadados da peça (assinatura classifica; notação escreve)
\newenvironment{TiffanyPeca}[1]{%
  \par\medskip\noindent
  \textbf{Peça / corpo:} #1\par
  \smallskip\noindent
  \begin{tabular}{@{}ll@{}}
}{%
  \end{tabular}\par\medskip
}

%% Inclusão da gravação tipográfica (PDF LilyPond em render/).
%% Preferir sempre o PDF pré-renderizado: o paper apresenta a partitura, não o .ly.
\makeatletter
\newcommand{\TiffanyRender}[2][]{%
  \IfFileExists{#2}{%
    \begin{center}
      \includegraphics[width=\textwidth,#1]{#2}%
    \end{center}%
  }{%
    \PackageWarning{tiffany-partitura}{render ausente: #2 --- corra partitura/render.sh}%
    \par\noindent\textit{(gravação tipográfica ausente:
      \texttt{partitura/render.sh})}\par
  }%
}

%% Inclusão: preferir PDF em render/; com [ly] usa lyluatex; senão listing do .ly.
%% Argumento = caminho do .ly (ex.: gabarito/tradutor-completo.ly).
\newcommand{\TiffanyLilyfile}[2][]{%
  \filename@parse{#2}%
  \edef\tiffany@render{render/\filename@base.pdf}%
  \IfFileExists{\tiffany@render}{%
    \TiffanyRender[#1]{\tiffany@render}%
  }{%
    \iftiffany@ly
      \lilypondfile[#1]{#2}%
    \else
      \par\smallskip\noindent{\small\textit{Gabarito LilyPond}
        (\texttt{\detokenize{#2}})
        --- \texttt{./render.sh} ou \texttt{lilypond}:}\par
      \lstinputlisting[language={},basicstyle=\ttfamily\footnotesize,
        frame=single,breaklines=true,columns=fullflexible]{#2}%
    \fi
  }%
}
\makeatother

%% Motivo Lei~8: ciclo $\mathbb{Z}/8\mathbb{Z}$ (k ↦ k+1 mod 8) como escala
%% ascendente de 8 semínimas — a orquestra por baixo é aritmética modular.
\newcommand{\TiffanyMotivoLeiOito}{%
c4 d e f | g a b c' |
}

\endinput
